# ---------------------------------------------------------------------------
# TerminalK - environment configuration (shared by all dashboards unless noted)
# Copy to .env.local (never commit real values). All keys are read server-side only.
# ---------------------------------------------------------------------------

# Data mode: "live" (default) fetches from official APIs. "demo" uses SYNTHETIC
# data for UI development only - every page shows a prominent warning banner.
DATA_MODE=live

# FRED API key (free: https://fred.stlouisfed.org/docs/api/api_key.html).
# Strongly recommended: provides series metadata (source last-updated timestamps)
# and higher reliability. Without it the app falls back to FRED's public
# per-series CSV download endpoint (no metadata, lower rate tolerance).
FRED_API_KEY=

# Optional market-data provider for series FRED does not carry
# (gold spot, Russell 2000 proxy). https://twelvedata.com - free tier is enough.
TWELVE_DATA_API_KEY=

# PostgreSQL connection string. If unset, the app runs with an in-memory cache
# (data is re-fetched on cold start; alerts are not persisted across restarts).
DATABASE_URL=
# TLS: "require" (verify certificate; set DATABASE_CA_CERT for providers with
# their own CA such as Supabase), "no-verify" (encrypt without verification).
# Supabase on Vercel: use the transaction pooler URL (port 6543).
DATABASE_SSL=
DATABASE_CA_CERT=

# Shared secret required by /api/cron/refresh (Authorization: Bearer <secret>).
# Vercel Cron sends this automatically when CRON_SECRET is set.
CRON_SECRET=

# Optional token for write endpoints (alerts, manual observations).
# Required to enable India Sentiment data ingestion (POST /api/india-sentiment/ingest).
# If set, requests must send header "x-admin-token: <token>".
ADMIN_TOKEN=

# Optional webhook that receives JSON when a user-configured alert fires.
ALERT_WEBHOOK_URL=

# In-memory cache lifetime (seconds) for the no-database mode.
CACHE_TTL_SECONDS=3600

# Optional global model-weight overrides (JSON). Example:
# MODEL_CONFIG_OVERRIDES={"categoryWeights":{"recession":{"credit_financial":30,"housing":5}},"overall":{"recession":60,"inflation":20,"financial":20}}
MODEL_CONFIG_OVERRIDES=

# --- India Market Sentiment Terminal -----------------------------------------
# Optional deployment-wide model overrides (JSON). Example:
# INDIA_SENTIMENT_CONFIG_OVERRIDES={"factorWeights":{"breadth":20,"valuation":2},"thresholds":[20,35,45,55,65,80],"strikeWindow":15}
INDIA_SENTIMENT_CONFIG_OVERRIDES=
# Licensed market-data credentials (NSE/BSE prices, breadth, flows, option chains) are read by the provider
# adapter you add in src/dashboards/india-sentiment/lib/data/providers/ - name them there, never expose them
# to the browser. Without a provider, push data via the ingestion API.

# Dhan (DhanHQ v2) market data for the India dashboard: NSE/BSE indices, India
# VIX, NIFTY/BANKNIFTY/FINNIFTY option chains, intraday prices. Server-side only;
# the app calls read-only DATA endpoints and never order/portfolio endpoints.
# Tokens from Dhan Web last 24 hours: when expired or rejected, the dashboard
# shows clearly labelled synthetic demo data until the token is renewed.
# DHAN_CLIENT_ID may be left empty: it is then read from the token itself.
DHAN_ACCESS_TOKEN=
DHAN_CLIENT_ID=
# Intraday refresh of today's index values and current-expiry chains while the
# market may be open (seconds, minimum 60).
INDIA_LIVE_REFRESH_SECONDS=180
